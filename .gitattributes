# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF (Linux containers)
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Keep Windows batch files with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
